<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOGS" value="./logs" />

    <!-- ── Console Appender (with MDC + color) ─────────────────────────── -->
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>%green(%d{ISO8601}) %highlight(%-5level) [%blue(%t)] %cyan([%X{request_id:-no-req}]) %yellow(%C{1}): %msg%n%throwable</Pattern>
        </layout>
    </appender>

    <!-- ── Rolling File Appender (with MDC) ────────────────────────────── -->
    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/spring-boot-logger.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d{ISO8601} %-5level [%t] [%X{request_id:-no-req}] %C{1}: %msg%n</Pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/app-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ── Audit File Appender (riêng cho audit trail) ─────────────────── -->
    <appender name="AuditFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/audit.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d{ISO8601} %-5level [%t] [%X{request_id:-no-req}] %msg%n</Pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/audit-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ── Audit Logger ────────────────────────────────────────────────── -->
    <logger name="AUDIT_TRAIL" level="INFO" additivity="false">
        <appender-ref ref="AuditFile" />
        <appender-ref ref="Console" />
    </logger>

    <!-- ── Root ────────────────────────────────────────────────────────── -->
    <root level="INFO">
        <appender-ref ref="RollingFile" />
        <appender-ref ref="Console" />
    </root>

    <!-- ── Loki Appender: đẩy log sang Loki server ──────────────────────── -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="NGN AI core" />
    <springProperty scope="context" name="lokiUrl" source="logging.loki.url" defaultValue="http://localhost:3100/loki/api/v1/push" />
    <springProperty scope="context" name="lokiUser" source="logging.loki.user" defaultValue="" />
    <springProperty scope="context" name="lokiPassword" source="logging.loki.password" defaultValue="" />

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}</url>
            <auth>
                <type>basic</type>
                <username>${lokiUser}</username>
                <password>${lokiPassword}</password>
            </auth>
            <!-- Timeout settings -->
            <connectTimeout>5000</connectTimeout>
            <readTimeout>10000</readTimeout>
            <retryInitialInterval>2000</retryInitialInterval>
            <retryMaxInterval>10000</retryMaxInterval>
            <retryCount>3</retryCount>
        </http>
        <format>
            <label>
                <pattern>app=${appName},host=${HOSTNAME},level=%level</pattern>
            </label>
            <message>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </message>
        </format>
        <!-- Batch settings -->
        <batch>
            <maxSize>10000</maxSize>
            <maxDuration>10000</maxDuration>
        </batch>
        <!-- Circuit breaker để không block app nếu Loki down -->
        <circuitBreaker>
            <errorThreshold>3</errorThreshold>
            <resetTimeout>30000</resetTimeout>
        </circuitBreaker>
    </appender>

    <root level="INFO">
        <appender-ref ref="RollingFile" />
        <appender-ref ref="Console" />
        <appender-ref ref="LOKI" />
    </root>

</configuration>
