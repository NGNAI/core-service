# .env

# Mật khẩu Redis (Spring Boot sẽ kết nối bằng mật khẩu này qua biến REDIS_PASSWORD)
REDIS_PASSWORD=P@ssw0rd

# Đường dẫn đến thư mục lưu trữ dữ liệu (persistence) của Redis
REDIS_DATA_PATH=/opt/dev/app/redis/data

# Port mà Redis sẽ lắng nghe
REDIS_PORT=6379

# Thời gian lưu dữ liệu tối đa trước khi ghi snapshot (AOF/appendonly file)
# Mặc định Redis sẽ ghi dữ liệu định kỳ tùy cấu hình
REDIS_MAXMEMORY=256mb
