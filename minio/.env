# .env

# Tài khoản người dùng gốc của MinIO (admin)
MINIO_ROOT_USER=admin

# Mật khẩu phải tối thiểu 8 ký tự, bao gồm ít nhất một chữ cái viết hoa, một chữ cái viết thường, một số và một ký tự đặc biệt.
MINIO_ROOT_PASSWORD=P@ssw0rd!@#

# Đường dẫn đến thư mục lưu trữ dữ liệu của MinIO
MINIO_DATA_PATH=/opt/dev/app/minio/data

# Port mà MinIO sẽ lắng nghe cho các yêu cầu HTTP
MINIO_API_PORT=9000

# Port mà MinIO sẽ lắng nghe cho giao diện quản lý (console)
MINIO_CONSOLE_PORT=9001